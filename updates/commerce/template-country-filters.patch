diff --git a/components/template-country-filter.tsx b/components/template-country-filter.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..573b3a86f5ab8ee345276ce90d5d221215facd5e
--- /dev/null
+++ b/components/template-country-filter.tsx
@@ -0,0 +1,28 @@
+"use client";
+
+import { useState } from "react";
+
+type Props = {
+  countries: string[];
+  value: string;
+  onChange: (value: string) => void;
+};
+
+export default function TemplateCountryFilter({ countries, value, onChange }: Props) {
+  const [expanded, setExpanded] = useState(false);
+  if (!countries.length) return null;
+
+  return <div className="catalog-country-filter" data-expanded={expanded}>
+    <div className="catalog-country-heading">
+      <span>国家 / 地区</span>
+      {countries.length >= 8 && <button type="button" className="catalog-country-toggle" aria-expanded={expanded} onClick={() => setExpanded(!expanded)}>
+        {expanded ? "收起" : "展开全部"}
+      </button>}
+    </div>
+    <div className="catalog-country-list" role="group" aria-label="按国家或地区筛选模板">
+      {["", ...countries].map(country => <button key={country} type="button" aria-pressed={value === country} onClick={() => onChange(country)}>
+        {country || "全部"}
+      </button>)}
+    </div>
+  </div>;
+}
diff --git a/lib/template-countries.mjs b/lib/template-countries.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..fb62b1bac0f3cdf55e15e1a948ce348d5c3f6146
--- /dev/null
+++ b/lib/template-countries.mjs
@@ -0,0 +1,22 @@
+export const unlistedCountry = "未标注";
+const preferredCountries = ["中国", "香港", "澳门", "台湾", "新加坡", "美国", "英国", "德国", "奥地利", "法国", "加拿大"];
+const countryAliases = new Map([
+  ["中国内地", "中国"], ["中国大陆", "中国"], ["中国香港", "香港"],
+  ["中国澳门", "澳门"], ["中国台湾", "台湾"],
+]);
+const countryCollator = new Intl.Collator("zh-CN");
+
+/** The supplier appends cities, flags and notes to the primary catalog country. */
+export function templateCountry(raw = "") {
+  if (!raw || raw.includes("实际地区未确认")) return unlistedCountry;
+  const primary = raw.trim().split(/[·（(；;\p{Regional_Indicator}\uFFFD]/u, 1)[0].trim().replace(/格式$/u, "");
+  return countryAliases.get(primary) || primary || unlistedCountry;
+}
+
+/** @param {string[]} labels */
+export function sortedTemplateCountries(labels) {
+  const unique = new Set(labels);
+  const first = preferredCountries.filter(label => unique.delete(label));
+  const hasUnlisted = unique.delete(unlistedCountry);
+  return [...first, ...Array.from(unique).sort(countryCollator.compare), ...(hasUnlisted ? [unlistedCountry] : [])];
+}
