+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { templateCountry, sortedTemplateCountries } from '../lib/template-countries.mjs';
+
+test('catalog countries group city and institution variants by their primary country', () => {
+  for (const [label, expected] of [
+    ['美国·纽约 🇺🇸', '美国'],
+    ['德国 🇩🇪（发行分支）；奥地利 🇦🇹（总行主体）', '德国'],
+    ['中国台湾·高雄', '台湾'], ['中国香港格式；页脚机构为英国','香港'],
+    ['越南 🇻��', '越南'], ['印度格式（₹）；机构和实际地区未确认','未标注'], ['', '未标注'],
+  ]) assert.equal(templateCountry(label), expected);
+  const labels = ['未标注','中国内地 🇨🇳','美国·纽约 🇺🇸','中国澳门 🇲🇴','美国 🇺🇸','中国香港 🇭🇰','中国台湾','英国 🇬🇧','日本 🇯🇵'];
+  assert.deepEqual(sortedTemplateCountries(labels.map(templateCountry)), ['中国','香港','澳门','台湾','美国','英国','日本','未标注']);
+});
