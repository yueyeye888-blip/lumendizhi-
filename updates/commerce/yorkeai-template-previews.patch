diff --git a/scripts/template-previews/build.mjs b/scripts/template-previews/build.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f4290afa79653f067e1b59a10ffe73c39739947a
--- /dev/null
+++ b/scripts/template-previews/build.mjs
@@ -0,0 +1,53 @@
+import { createHash } from 'node:crypto';
+import { mkdir, readFile, rename } from 'node:fs/promises';
+import path from 'node:path';
+import sharp from 'sharp';
+
+const [sourceDirectory, outputDirectory] = process.argv.slice(2);
+if (!sourceDirectory || !outputDirectory || path.resolve(sourceDirectory) === path.resolve(outputDirectory)) {
+  throw Error('Usage: node scripts/template-previews/build.mjs PUBLIC_PREVIEW_SOURCES OUTPUT_DIRECTORY');
+}
+const layouts = JSON.parse(await readFile(new URL('./layouts.json', import.meta.url), 'utf8'));
+
+// Coordinates refer to the public sample in its original orientation. The backing
+// is opaque where a vendor mark is printed into the pixels.
+function stamp(x, y, width, height, fontSize, opacity = 1) {
+  const lineStart = width / 2 - fontSize * .45;
+  const lineEnd = fontSize * 2.05;
+  return `<g transform="translate(${x} ${y}) rotate(28)" opacity="${opacity}">
+    <rect x="${-width / 2}" y="${-height / 2}" width="${width}" height="${height}" rx="${height * .11}" fill="#f1f5f9" stroke="#cad5e2" stroke-width="${height * .022}"/>
+    ${lineStart > lineEnd + 2 ? `<path d="M-${lineStart} 0H-${lineEnd} M${lineEnd} 0H${lineStart}" stroke="#b5c4d3" stroke-width="${height * .035}"/>` : ''}
+    <text x="0" y="${fontSize * .35}" text-anchor="middle" font-family="Arial, DejaVu Sans, sans-serif" font-weight="bold" font-size="${fontSize}" fill="#516982">YorkeAI</text>
+  </g>`;
+}
+
+function marks(id, grid, width, height) {
+  if (!grid) {
+    return [.26, .75].map(fraction => stamp(width / 2, height * fraction, width * .45, width * .096, width * .064, .88)).join('');
+  }
+  const [firstX, firstY, stepX, stepY] = grid;
+  const address = id.startsWith('addr-');
+  const scale = stepX / (address ? 337 : 112.5);
+  const stampWidth = (address ? 387 : 103) * scale;
+  const stampHeight = (address ? 54 : 31) * scale;
+  let drawing = '';
+  for (let row = 0; firstY + row * stepY - stampWidth / 2 < height; row++) {
+    const stagger = address && row % 2 ? stepX / 2 : 0;
+    for (let x = firstX - stagger; x - stampWidth / 2 < width; x += stepX) {
+      drawing += stamp(x, firstY + row * stepY, stampWidth, stampHeight, (address ? 34 : 15) * scale);
+    }
+  }
+  return drawing;
+}
+
+await mkdir(outputDirectory, { recursive: true });
+for (const [id, { sha256, grid }] of Object.entries(layouts)) {
+  const bytes = await readFile(path.join(sourceDirectory, id + '.img'));
+  if (createHash('sha256').update(bytes).digest('hex') !== sha256) throw Error('Review changed sample before rendering ' + id);
+  const { width, height } = await sharp(bytes).metadata();
+  const graphic = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}">${marks(id, grid, width, height)}</svg>`;
+  const output = path.join(outputDirectory, id + '.webp');
+  await sharp(bytes).composite([{ input: Buffer.from(graphic) }]).webp({ quality: 87, effort: 3 }).toFile(output + '.tmp');
+  await rename(output + '.tmp', output);
+}
+console.log('Generated %d branded previews.', Object.keys(layouts).length);
