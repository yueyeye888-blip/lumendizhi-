+        .run(id,user.id,user.email,ref,msg,Date.now());
+      return;
+    }
+    if (!owner) throw fault(403,'仅平台所有者可以处理工单和复核退款。');
+    if(action==='reply'){
+      const result=db.prepare('UPDATE support_tickets SET reply=?,replied_by=?,replied_at=? WHERE id=? AND reply IS NULL')
+        .run(field(f,'reply',2000),user.id,Date.now(),field(f,'id',60));
+      if(!result.changes)throw fault(409,'工单已回复或不存在。');
+      return;
+    }
+    if(action==='decide')return address.decideRefund(user,field(f,'id',100),field(f,'decision',12),field(f,'note',500));
+    throw fault(400,'无效操作。');
+  }
+  const hidden=(key,value)=>'<input type="hidden" name="'+key+'" value="'+esc(value)+'">';
+  const form=(action,id,body)=>'<form method="post" action="'+urlPath+'">'+hidden('action',action)+hidden('id',id)+body+'</form>';
+  function render(user,owner,url) {
+    const page=Math.max(0,Math.min(100000,parseInt(url.searchParams.get('page'),10)||0));
+    const args=owner?[]:[user.id];
+    const tickets=db.prepare('SELECT * FROM support_tickets '+(owner?'':'WHERE user_id=?')+' ORDER BY (reply IS NULL) DESC,created_at DESC LIMIT 21 OFFSET ?').all(...args,page*20);
+    const reviews=db.prepare(`SELECT r.*, b.request_no, COALESCE(p.amount_raw,h.amount) AS amount
+      FROM address_refund_reviews r JOIN address_bills b ON b.id=r.bill_id
+      LEFT JOIN address_prepayments p ON p.bill_id=b.id LEFT JOIN wallet_holds h ON h.reference=b.id
+      ${owner?'':'WHERE b.user_id=?'} ORDER BY (r.decision='pending') DESC,r.opened_at DESC LIMIT 21 OFFSET ?`).all(...args,page*20);
+    const makeTicket=form('create',randomUUID(),'<label>订单号（选填）<input name="order" maxlength="100" value="'+esc((url.searchParams.get('order')||'').slice(0,100))+'"></label><label>问题描述<textarea name="message" required maxlength="2000" rows="3"></textarea></label><button>提交工单</button>');
+    const records=tickets.slice(0,20).map(t=>'<article><strong>工单 '+esc(t.id.slice(0,8))+' · '+(t.reply?'已回复':'待回复')+'</strong><small>'+esc(when(t.created_at))+(owner?' · '+esc(t.email):'')+'</small>'+(t.order_ref?'<p>关联订单 '+esc(t.order_ref)+'</p>':'')+'<p>'+esc(t.message)+'</p>'+(t.reply?'<p><b>客服回复</b> '+esc(t.reply)+'</p>':owner?form('reply',t.id,'<label>回复<textarea name="reply" required maxlength="2000"></textarea></label><button>发送回复</button>'):'')+'</article>').join('');
+    const cases=reviews.slice(0,20).map(r=>'<article><strong>'+esc(r.request_no)+' · '+esc(states[r.decision])+'</strong><small>'+esc(when(r.opened_at))+' · '+esc(r.amount/10000)+' U</small><p>'+esc(r.reason)+'</p>'+(r.decision_note?'<p>复核说明 '+esc(r.decision_note)+'</p>':'')+(owner&&r.decision==='pending'?form('decide',r.bill_id,'<label>复核说明<textarea name="note" maxlength="500" required></textarea></label><button name="decision" value="approved">确认程序异常，批准退款</button> <button name="decision" value="declined">不予退款</button>'):'')+'</article>').join('');
+    const nav=(page?'<a href="?page='+(page-1)+'">上一页</a> ':'')+(Math.max(reviews.length,tickets.length)>20?'<a href="?page='+(page+1)+'">下一页</a>':'');
+    return withLocale('<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>客服中心 · YorkeAI</title></head><body class="support-page"><main><a href="/">返回平台</a><h1>客服中心</h1><p>Telegram '+tg+'</p><section><h2>提交工单</h2>'+makeTicket+'</section>'+((owner||cases)?'<section><h2>'+(owner?'订单退款复核':'我的订单复核')+'</h2>'+(cases||'<p>暂无待复核订单。</p>')+'</section>':'')+'<section><h2>'+(owner?'客户工单':'我的工单')+'</h2>'+(records||'<p>暂无工单。</p>')+'</section>'+nav+'</main></body></html>');
+  }
+  return async function route(req,res,url,user) {
+    if(url.pathname!==urlPath)return false;
+    const owner=canManageAccounts(config,user);
+    try{
+      if(req.method==='GET'){
+        const html=render(user,owner,url);
+        res.writeHead(200,{'content-type':'text/html; charset=utf-8','cache-control':'private, no-store','content-security-policy':"default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"});
+        res.end(html);
+      }else if(req.method==='POST'){
+        await post(req,user,owner);
+        res.writeHead(303,{location:urlPath,'cache-control':'no-store'});res.end();
+      }else{res.writeHead(405,{allow:'GET, POST'});res.end();}
+    }catch(e){
+      if(res.headersSent) throw e;
+      const status=e.status||503;
+      res.writeHead(status,{'content-type':'text/html; charset=utf-8','cache-control':'no-store'});
+      res.end('<meta charset="utf-8"><p>'+esc(e.status?e.message:'服务暂时不可用，请稍后查询。')+'</p><a href="'+urlPath+'">返回客服中心</a>');
+    }
+    return true;
+  };
+}
