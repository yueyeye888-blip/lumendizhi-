+(() => {
+  if(location.pathname==='/__host/support')return;
+  const order=/^\/address-orders\/(ADDR-[\dA-Z-]+)\/?$/.exec(location.pathname)?.[1];
+  const href='/__host/support'+(order?'?order='+encodeURIComponent(order):'');
+  function links(floating) {
+    const nav=document.createElement('nav');
+    nav.className=floating?'support-links support-floating':'support-links';
+    nav.setAttribute('aria-label','客服');
+    for(const [label,url] of [['客服工单',href],['TG @YorkeYue','https://t.me/YorkeYue']]){
+      const link=document.createElement('a');
+      link.href=url;link.textContent=label;link.target='_blank';link.rel='noopener noreferrer';nav.append(link);
+    }
+    return nav;
+  }
+  const floating=links(true);
+  document.body.append(floating);
+  function attach(){
+    for(const modal of document.querySelectorAll('dialog[open], [role="dialog"][aria-modal="true"]')){
+      if(!modal.querySelector('.support-links'))modal.append(links(false));
+    }
+  }
+  attach();
+  let scheduled=false;
+  new MutationObserver(()=>{
+    if(!scheduled){scheduled=true;requestAnimationFrame(()=>{scheduled=false;attach();});}
+  }).observe(document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['open','aria-modal']});
+})();
