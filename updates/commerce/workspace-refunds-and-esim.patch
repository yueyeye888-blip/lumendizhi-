+      result.push({id:`low-data:${item.esimTranNo}:${item.totalVolume}`,resource:item.esimTranNo,kind:'low_data',text:`${label} · 剩余流量 ${(Math.floor(left * 10) / 10).toFixed(1)}%`});
+    }
+  }
+  return result;
+}
