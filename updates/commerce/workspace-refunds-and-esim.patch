+/* Refund review: master list and financial decision pane. */
+.review-console {background:#f3f5f4;color:#152a2b;font-family:Inter,system-ui,sans-serif}
+.review-console main {width:min(calc(100% - 48px),1240px);margin:auto;padding:24px 0 80px}
+.review-crumb {display:flex;align-items:center;gap:12px;font-size:13px;color:#637374;margin-bottom:20px}
+.review-crumb a {font-weight:750;color:#183c36;text-decoration:none}
+.review-banner {display:flex;align-items:center;justify-content:space-between;gap:30px;padding:34px 38px;border-radius:16px;background:linear-gradient(115deg,#102b2b,#153f38 64%,#20604e);color:white}
+.review-console .review-banner h1 {font-size:clamp(29px,3vw,42px);font-weight:650;line-height:1.15;letter-spacing:-.04em}
+.review-banner p {color:#c6dbd3;margin:12px 0 0;font-size:14px;line-height:1.6;max-width:560px}
+.review-banner dl,.case-detail dl {display:flex;gap:28px;margin:0}
+.review-banner dl>div {padding-left:22px;border-left:1px solid #ffffff38}
+.review-banner dt {color:#c6dbd3;font-size:12px}
+.review-banner dd {font-size:28px;margin:6px 0 0;white-space:nowrap;font-variant-numeric:tabular-nums}
+.review-banner small,.case-detail small {display:inline;font-size:.6em;color:inherit}
+.review-desk {margin-top:22px;display:grid;grid-template-columns:minmax(340px, .96fr) minmax(380px,1.24fr);gap:18px;align-items:start}
+.review-console main section:is(.review-queue,.case-detail) {margin:0;border:1px solid #d8e0dc;border-radius:13px;background:#fff;box-shadow:0 3px 12px #132d2810}
+.review-console main section.review-queue {padding:0;overflow:hidden}
+.review-tabs {display:flex;gap:18px;padding:0 20px;border-bottom:1px solid #dce4df}
+.review-tabs a {display:flex;gap:8px;align-items:center;padding:16px 0;color:#657673;text-decoration:none;border-bottom:2px solid transparent;font-size:14px}
+.review-tabs a[aria-current] {color:#006453;border-color:#167562;font-weight:750}
+.review-tabs b {border-radius:20px;padding:1px 6px;background:#edf2ef;font-size:11px}
+.review-queue ul {margin:0;padding:0;list-style:none}
+.review-queue li+li {border-top:1px solid #e6ece8}
+.review-queue li a {display:grid;grid-template-columns:1fr auto;align-items:center;gap:7px 10px;padding:15px 18px;text-decoration:none;color:#213632;border-left:3px solid transparent}
+.review-queue li a[aria-current] {border-color:#167562;background:#edf7f2}
+.review-queue li strong {font:650 13px/1.45 'IBM Plex Mono',ui-monospace,monospace;overflow-wrap:anywhere}
+.review-queue li b {text-align:right;font-size:14px}
+.review-queue li time {color:#627570;font-size:12px}
+.review-status {display:inline-flex;align-items:center;justify-self:end;gap:6px;width:max-content;padding:3px 8px;border-radius:15px;background:#edf1f4;color:#465660;font:650 12px/1.5 system-ui}
+.review-status::before {content:'';width:6px;height:6px;border-radius:50%;background:currentColor}
+.review-status[data-state=pending] {color:#8b5306;background:#fff2d8}
+.review-status[data-state=approved],.review-status[data-state=delivered] {background:#dff3e9;color:#126044}
+.review-queue .queue-empty {padding:38px 22px;color:#647671}
+.review-pages:not(:empty) {padding:12px 20px;display:flex;gap:12px}
+.review-desk:has(.queue-empty) {grid-template-columns:1fr}
+.review-console main section.case-detail {padding:26px;scroll-margin-top:65px}
+.case-title h2 {margin:12px 0 20px;font:650 clamp(16px,2vw,23px)/1.45 'IBM Plex Mono',ui-monospace,monospace;overflow-wrap:anywhere}
+.case-detail dl {padding:16px 0;border-block:1px solid #e0e7e3;flex-wrap:wrap}
+.case-detail dt,.case-detail h3 {font-size:12px;font-weight:650;color:#526760}
+.case-detail dd {margin:5px 0 0;font-size:16px;font-variant-numeric:tabular-nums}
+.case-detail h3 {margin:20px 0 7px}
+.case-detail .case-note {font-size:14px;line-height:1.65;color:#273c35;margin:0 0 16px}
+.case-detail form {border-top:1px solid #e0e7e3;padding-top:18px}
+.case-detail textarea {min-height:80px;border-color:#ccd8d0}
+.case-detail form button[value=approved] {background:#17664f;border-color:#17664f}
+.esim-row-archive {padding:6px 10px;border:1px solid #cbd8d4;border-radius:7px;color:#286656;font-size:11px;white-space:nowrap}
+.esim-row-archive:disabled {opacity:.5}
